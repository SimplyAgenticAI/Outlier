{
  "manifest_version": 3,
  "name": "Outlier — Facebook capture",
  "version": "0.17.0",
  "description": "Captures posts from Facebook groups and profiles you're viewing, and sends them to your Outlier dashboard for outlier analysis.",
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": [
    "http://localhost:5050/*",
    "http://127.0.0.1:5050/*",
    "https://*.onrender.com/*",
    "https://*.facebook.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "comment": "Runs on the dashboard only, so it can hand the extension its endpoint and key in one click instead of the user typing them.",
      "matches": [
        "http://localhost:5050/*",
        "http://127.0.0.1:5050/*",
        "https://*.onrender.com/*"
      ],
      "js": ["connect.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Outlier"
  }
}
